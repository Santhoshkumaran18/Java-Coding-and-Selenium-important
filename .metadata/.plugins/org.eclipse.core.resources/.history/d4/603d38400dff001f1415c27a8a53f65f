package selenium12March;

import java.io.File;
import java.io.FileNotFoundException;
import java.io.FileOutputStream;
import java.io.IOException;
import java.util.Scanner;

import org.apache.poi.xssf.usermodel.XSSFCell;
import org.apache.poi.xssf.usermodel.XSSFRow;
import org.apache.poi.xssf.usermodel.XSSFSheet;
import org.apache.poi.xssf.usermodel.XSSFWorkbook;

public class ApachePOIWritingtheDynamicData {
	public static void main(String[] args) throws IOException {
		File file=new File(System.getProperty("user.dir")+ "\\utilities\\Data.xlsx");
		FileOutputStream fos=new FileOutputStream(file);
		XSSFWorkbook workbook=new XSSFWorkbook();
		XSSFSheet sheet=workbook.createSheet("Data sheet");
		
		Scanner s=new Scanner(System.in);
		
		
		workbook.write(fos);
		workbook.close();
		fos.close();
		
		System.out.println("File is created successfully in the folder and please check that");
		
		
		
		
	}
}
