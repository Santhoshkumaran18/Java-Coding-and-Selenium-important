package JavaFastRevision;

public class MoveOddAndEvenTooneSide {
	public static void main(String[] args) {
		
	}
	
	public static void oddEven(int arr[]) {
		int lo=0,hi=arr.length-1;
		
		while(lo<hi) {
			if(arr[lo]==0 && lo<hi) {
				lo++;
			}
			if(arr[hi]==1 && lo<hi) {
				hi--;
			}
			
		}
	}
}
